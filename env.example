# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- MIMIC-III database (your own instance) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mimiciii
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- LLM provider ---
# Only aggregate statistics are sent. See "Data access and compliance" in README.
OPENAI_API_KEY=sk-your-key-here
